{
  "name": "@repo/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env TSX_TSCONFIG_PATH=tsconfig.dev.json tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@repo/ai-market-intelligence": "workspace:*",
    "@repo/api-contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/forecasting": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/providers": "workspace:*",
    "@repo/signals": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}