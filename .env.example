NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=
DIRECT_URL=
# Set to false for local UI-first development without DB hard dependency.
ENABLE_PRISMA_DB=true
# Optional local guardrail for server DB reads in milliseconds.
DB_READ_TIMEOUT_MS=2000
NEWS_READ_TIMEOUT_MS=3000
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_SESSION_DAYS=30

NEXT_PUBLIC_APP_NAME=Aurox Intelligence
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

WORKER_CONCURRENCY=2
LOG_LEVEL=info

MARKET_DATA_PROVIDER=finnhub
MARKET_STREAM_PROVIDER=finnhub
MARKET_METADATA_PROVIDER=polygon
MARKET_HISTORY_FALLBACK_PROVIDERS=polygon,twelve-data,eodhd
MARKET_QUOTE_FALLBACK_PROVIDERS=polygon,twelve-data,eodhd
CRYPTO_STREAM_PROVIDER=coinbase
CRYPTO_HISTORY_PROVIDER=coingecko
MACRO_DATA_PROVIDER=
NEWS_DATA_PROVIDER=

ENABLE_BINANCE_STREAM=true
ENABLE_BYBIT_PUBLIC_STREAM=true
ENABLE_OKX_PUBLIC_STREAM=true
ENABLE_COINBASE_PUBLIC_STREAM=true

MARKET_STREAM_RECONNECT_MAX_ATTEMPTS=20
MARKET_STREAM_HEARTBEAT_INTERVAL_MS=30000
MARKET_STREAM_STALE_AFTER_MS=45000
MARKET_STREAM_EVENT_BUFFER_SIZE=5000

# -----------------------------------------------------------------------------
# Market News / RSS Feeds
# -----------------------------------------------------------------------------
# Enables homepage market news section.
NEXT_PUBLIC_ENABLE_MARKET_NEWS=true

# Default news mode.
# rss = free/public feeds, api = provider API, mock = local fallback
MARKET_NEWS_MODE=rss

# Comma-separated RSS feed URLs.
# Keep at least 3 free sources enabled by default.
# Default stable free feeds: MarketWatch, Nasdaq, CoinDesk
MARKET_NEWS_RSS_FEEDS=https://www.marketwatch.com/rss/topstories,https://www.nasdaq.com/feed/rssoutbound,https://www.coindesk.com/arc/outboundfeeds/rss/

# Optional API providers.
# Leave empty unless configured.
NEWS_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=

# Cache TTL in seconds for market news fetches.
MARKET_NEWS_CACHE_TTL_SECONDS=900

# Max items per source on homepage.
MARKET_NEWS_ITEMS_PER_SOURCE=6

# Optional/unstable source placeholders (do not enable blindly without policy/licensing checks):
# - Yahoo Finance (strong free source, RSS/API endpoints vary)
# - CNBC Markets (headline quality strong, feed terms may vary)
# - Reuters Business/Markets (licensing restrictions likely)
# - FT Alphaville (free after registration; not a standard open RSS contract)
# - Investopedia (education/explainers, less breaking-news oriented)
# - NewsAPI.org / Financial Modeling Prep (API-based, plan limits and terms apply)

POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
TIINGO_API_KEY=
COINGECKO_API_KEY=
FINNHUB_API_KEY=
EODHD_API_KEY=

FINNHUB_MARKET_SYMBOLS=
EODHD_MARKET_SYMBOLS=
MARKET_SYMBOLS=

# ------------------------------------------------------------
# Broker execution runtime
# ------------------------------------------------------------
# simulation | binance | coinbase
BROKER_EXECUTION_PROVIDER=simulation

# Keep this TRUE until you have fully validated the pipeline.
BROKER_DRY_RUN=true

# Global execution safety gate.
BROKER_SANDBOX_MODE=true

# Optional: restrict which broker mode IDs may use live execution.
# Example:
# BROKER_ALLOWED_LIVE_MODE_IDS=guardrailed_auto_live
BROKER_ALLOWED_LIVE_MODE_IDS=

BROKER_ORDER_TIMEOUT_MS=10000

# ------------------------------------------------------------
# Binance Spot
# Official testnet REST base:
# https://testnet.binance.vision/api
# ------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE_URL=https://testnet.binance.vision
BINANCE_RECV_WINDOW_MS=5000
BINANCE_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,ADAUSDT,AVAXUSDT,DOGEUSDT,LINKUSDT,DOTUSDT,MATICUSDT,POLUSDT,LTCUSDT,BCHUSDT,UNIUSDT,ATOMUSDT,NEARUSDT,APTUSDT,ARBUSDT,OPUSDT,ETCUSDT,FILUSDT,ICPUSDT,INJUSDT,TONUSDT,TRXUSDT,HBARUSDT,VETUSDT,ALGOUSDT,AAVEUSDT,RNDRUSDT,SUIUSDT,SEIUSDT,SHIBUSDT,PEPEUSDT

# ------------------------------------------------------------
# Coinbase Advanced Trade
# Official production API host:
# https://api.coinbase.com
# Keep the secret on one line using \n if needed.
# Example:
# COINBASE_API_KEY_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n
# ------------------------------------------------------------
COINBASE_API_KEY_ID=
COINBASE_API_KEY_SECRET=
COINBASE_API_BASE_URL=https://api.coinbase.com
COINBASE_ALLOWED_PRODUCT_IDS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,BNB-USD,ADA-USD,AVAX-USD,DOGE-USD,LINK-USD,DOT-USD,MATIC-USD,LTC-USD,BCH-USD,UNI-USD,ATOM-USD,NEAR-USD,APT-USD,ARB-USD,OP-USD,ETC-USD,FIL-USD,ICP-USD,INJ-USD,TON-USD,TRX-USD,HBAR-USD,VET-USD,ALGO-USD,AAVE-USD,RNDR-USD,SUI-USD,SEI-USD,SHIB-USD,PEPE-USD
COINBASE_JWT_EXPIRES_IN_SEC=120

# Optional emergency override if you already generate JWT elsewhere:
COINBASE_BEARER_TOKEN=
COINBASE_PORTFOLIO_UUID=

# ------------------------------------------------------------
# AI Simulation Broker Agent (Simulation-only support)
# Server-side only. Never exposed to the client.
# AI providers do NOT enable live trading. Simulation-first only.
#
# Preferred keys:
# - ANTHROPIC_API_KEY from Anthropic Console
# - OPENAI_API_KEY optional fallback
#
# Backward compatibility:
# - CLAUDE_FINANCE_API_KEY is still accepted as a deprecated alias
#   for ANTHROPIC_API_KEY. Prefer ANTHROPIC_API_KEY going forward.
# ------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_SIM_AGENT_MODEL=gpt-4o-mini

ANTHROPIC_PROVIDER_ENABLED=true
OPENAI_PROVIDER_ENABLED=true
AI_PRIMARY_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=openai

CLAUDE_FINANCE_API_KEY=
CLAUDE_FINANCE_PROVIDER_ENABLED=true

# Simulation account default cash currency: EUR or USD
SIMULATION_DEFAULT_CASH_CURRENCY=EUR

# Micro trading simulation mode (strictly simulation-only)
FEATURE_SIM_MICRO_TRADING=false

ERSTE_CONNECT_CLIENT_ID=
ERSTE_CONNECT_CLIENT_SECRET=
ERSTE_CONNECT_REDIRECT_URI=
ERSTE_CONNECT_AUTH_URL=
ERSTE_CONNECT_TOKEN_URL=
ERSTE_CONNECT_API_BASE_URL=
ENABLE_SPARKASSE_GEORGE_SANDBOX=false
