{
  "name": "stock-trend-prediction-platform",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:worker": "pnpm --filter @repo/worker dev",
    "build:web": "pnpm --filter @repo/web build",
    "build:worker": "pnpm --filter @repo/worker build",
    "typecheck:web": "pnpm --filter @repo/web typecheck",
    "typecheck:worker": "pnpm --filter @repo/worker typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@next/env": "^16.2.4",
    "zod": "^4.1.5"
  }
}