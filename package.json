{
  "name": "stock-trend-prediction-platform",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "env:check": "node scripts/env-check.mjs",
    "dev:web": "turbo run dev --filter=@repo/web",
    "dev:worker": "turbo run dev --filter=@repo/worker",
    "build:web": "pnpm --filter @repo/web build",
    "build:worker": "pnpm --filter @repo/worker build",
    "typecheck:web": "pnpm --filter @repo/web typecheck",
    "typecheck:worker": "pnpm --filter @repo/worker typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv-cli": "^11.0.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@next/env": "^16.2.4",
    "zod": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.12",
      "brace-expansion@2": "^2.0.2"
    }
  }
}